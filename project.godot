; Engine configuration file.
; Pin: Godot 4.7.2-stable (see README and .github/workflows).

config_version=5

[application]

config/name="Iso Adventure"
config/description="Zelda-like 3D isometric low-poly action-adventure (prototype)."
run/main_scene="res://scenes/levels/test_room.tscn"
config/show_boot_splash=false
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

